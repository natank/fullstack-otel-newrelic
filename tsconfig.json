{
  "compilerOptions": {
    "target": "ESNext",                 
    "module": "NodeNext",               
    "moduleResolution": "NodeNext",     
    "outDir": "./dist",                 
    "rootDir": "./",                    
    "strict": true,                     
    "esModuleInterop": true,            
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["*.ts", "services/shared/tracer.ts", "services/shared/otel/tracing.ts", "services/shared/middleware.ts", "services/shared/metrics.ts", "services/todo/todo-service.ts"]
}
